# Inspect-AI eval logs: one full run is ~30MB.
/logs/
# Generated figures. figures_remote* covers the copies pulled back from a pod;
# the trailing glob matters, because a plain /figures_remote/ missed
# figures_remote2/ and left 91MB one `git add -A` away from being committed.
/figures/
/figures_remote*/
/figures_legacy/
temp_dataset_download/

# Generation intermediates are local. The three provenance files per axis ship.
face_eval_generator/data/**
!face_eval_generator/data/*/
!face_eval_generator/data/*/ideation.jsonl
!face_eval_generator/data/*/reviews.json
!face_eval_generator/data/*/scenarios.jsonl

docs/plans/
